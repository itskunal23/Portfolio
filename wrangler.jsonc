{
  // Cloudflare Workers config for Kunal Goenka's portfolio: a statically
  // generated Astro site served from Workers Static Assets. No Worker script
  // is needed. An explicit config file also disables Wrangler's framework
  // auto-configuration.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "portfolio",
  "compatibility_date": "2026-11-04",
  "assets": {
    // Output of `pnpm build` (astro build).
    "directory": "./dist",
    // Every route is a real prerendered page, so unknown paths get the
    // generated 404.html with a 404 status (not an SPA fallback).
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
