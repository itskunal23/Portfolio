---
import Keyboard from "./Keyboard.astro";
import { files, terminalRuns } from "~/data/laptop";
import { highlightLine } from "~/lib/highlight";
import { profile } from "~/data/profile";
import { projects } from "~/data/projects";

// What the terminal's built-in commands print. Content stays in data files.
const shell = {
  whoami: `${profile.name}: ${profile.role}. MS Computer Science (AI), Georgia Tech.`,
  email: profile.email,
  projects: projects.filter((p) => p.featured).map((p) => ({ title: p.title, href: `/work/${p.slug}/` }))
};

// Typing schedule, computed at build time: each line types at a steady
// rate and starts when the previous one ends. CSS plays it; no JS needed.
const MS_PER_CHAR = 11;
const typed = files.map((f) => {
  let t = 0;
  return f.lines.map((line) => {
    const n = Math.max(1, line.length);
    const row = { html: highlightLine(line) || " ", n, delay: t, dur: Math.max(90, n * MS_PER_CHAR) };
    t += row.dur + 40;
    return row;
  });
});
const first = terminalRuns[0]!;
---

<figure class="scene" data-laptop>
  <div class="laptop">
    <div class="lid">
      <span class="notch" aria-hidden="true"></span>
      <div class="screen">
        <div class="chrome">
        <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <div class="tabs" role="tablist" aria-label="Example files">
          {
            files.map((f, i) => (
              <button
                type="button"
                role="tab"
                id={`lt-tab-${i}`}
                aria-controls={`lt-panel-${i}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
              >
                {f.name}
              </button>
            ))
          }
        </div>
        </div>
        {
          files.map((_, i) => (
            <pre class="code typing" role="tabpanel" id={`lt-panel-${i}`} aria-labelledby={`lt-tab-${i}`} hidden={i !== 0} tabindex="0"><code>{typed[i]!.map((r) => <span class="ln" style={`--n:${r.n};--d:${r.delay}ms;--t:${r.dur}ms`} set:html={r.html} />)}</code></pre>
          ))
        }
        <div class="term">
          <div class="term-bar">
            <span>terminal</span>
            <button type="button" class="run" data-run>
              <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor"></path></svg>
              <span data-run-label>Run</span>
            </button>
          </div>
          <ol class="log" data-log aria-live="polite">
            <li class="prompt">$ agent ask "{first.question}"</li>
            <li class="hint">Press Run, or type a question below. Try help.</li>
          </ol>
          <form class="ask" data-ask>
            <label for="lt-q" class="visually-hidden">Ask the simulated agent, or type help</label>
            <span aria-hidden="true">$</span>
            <input id="lt-q" name="q" type="text" autocomplete="off" spellcheck="false" maxlength="80" placeholder="ask anything, or type help" />
          </form>
        </div>
      </div>
    </div>
    <div class="base">
      <span class="grille" aria-hidden="true"></span>
      <Keyboard />
      <span class="grille" aria-hidden="true"></span>
      <div class="trackpad" data-trackpad aria-hidden="true"></div>
    </div>
  </div>
  <figcaption>Simulated run. Illustrative code and values, not production data.</figcaption>
  <script type="application/json" data-runs set:html={JSON.stringify(terminalRuns)} />
  <script type="application/json" data-shell set:html={JSON.stringify(shell)} />
</figure>

<script>
  import type { TerminalRun } from "~/data/laptop";

  const scene = document.querySelector<HTMLElement>("[data-laptop]");
  if (scene) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    const tabs = [...scene.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...scene.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    // ---- Tabs (automatic activation, arrow keys) ----
    const select = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        t.setAttribute("aria-selected", String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panels.forEach((p, k) => {
        p.hidden = k !== i;
        if (k === i) {
          // Replay the typing on the file that just opened.
          p.classList.remove("typing", "replay");
          void p.offsetWidth;
          p.classList.add("typing", "replay");
        }
      });
      if (focus) tabs[i]!.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i));
      t.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        select((i + d + tabs.length) % tabs.length, true);
      });
    });

    // ---- Terminal ----
    const runs = JSON.parse(scene.querySelector("[data-runs]")!.textContent!) as TerminalRun[];
    const log = scene.querySelector<HTMLOListElement>("[data-log]")!;
    const btn = scene.querySelector<HTMLButtonElement>("[data-run]")!;
    const label = scene.querySelector<HTMLElement>("[data-run-label]")!;
    // The trackpad clicks like a Force Touch pad and presses Run.
    const pad = scene.querySelector<HTMLElement>("[data-trackpad]");
    pad?.addEventListener("pointerdown", (e) => {
      e.preventDefault();
      pad.classList.add("down");
      btn.click();
    });
    for (const ev of ["pointerup", "pointerleave", "pointercancel"]) pad?.addEventListener(ev, () => pad.classList.remove("down"));
    let n = 0;
    const shell = JSON.parse(scene.querySelector("[data-shell]")!.textContent!) as {
      whoami: string;
      email: string;
      projects: { title: string; href: string }[];
    };
    const line = (text: string, cls = "") => Object.assign(document.createElement("li"), { textContent: text, className: cls });
    const linkLine = (text: string, href: string) => {
      const li = line("", "step");
      li.append(Object.assign(document.createElement("a"), { textContent: text, href }));
      return li;
    };
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduced.matches ? 0 : ms));
    const print = (...items: HTMLLIElement[]) => {
      log.append(...items);
      log.scrollTop = log.scrollHeight;
    };
    let busy = false;

    const play = async (run: TerminalRun) => {
      busy = true;
      btn.setAttribute("aria-busy", "true");
      label.textContent = "Running";
      log.replaceChildren(line(`$ agent ask "${run.question}"`, "prompt"));
      for (const s of run.steps) {
        await wait(300);
        print(line(s, "step"));
      }
      await wait(360);
      print(line(`${run.result.kind === "answer" ? "✓" : "⚑"} ${run.result.text}`, `result ${run.result.kind}`));
      btn.removeAttribute("aria-busy");
      label.textContent = "Run again";
      busy = false;
    };

    btn.addEventListener("click", () => {
      if (!busy) void play(runs[n++ % runs.length]!);
    });

    // A free-text question gets a simulated run. The outcome is derived from
    // the question itself: varied across questions, stable for each one.
    const simulate = (q: string): TerminalRun => {
      let h = 2166136261;
      for (const c of q.toLowerCase()) h = Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0;
      const score = 0.35 + (h % 64) / 100;
      const parts = 1 + (h % 3);
      const ok = score >= 0.8;
      return {
        question: q,
        steps: [
          `plan      split into ${parts} sub-question${parts > 1 ? "s" : ""}`,
          "retrieve  bm25 + dense, 8 passages reranked",
          `cite      ${ok ? "every claim has a source" : "a claim is missing its source"}`,
          `check     confidence ${score.toFixed(2)}, threshold 0.80`
        ],
        result: ok ? { kind: "answer", text: "Answered, with citations" } : { kind: "person", text: "Routed to a person for review" }
      };
    };

    const ask = scene.querySelector<HTMLFormElement>("[data-ask]")!;
    ask.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = ask.elements.namedItem("q") as HTMLInputElement;
      const q = input.value.trim();
      input.value = "";
      if (!q || busy) return;
      const cmd = q.toLowerCase();
      if (cmd === "clear") return log.replaceChildren();
      if (["help", "whoami", "projects", "contact"].includes(cmd)) {
        print(line(`$ ${cmd}`, "prompt"));
        if (cmd === "help") print(line("whoami  projects  contact  clear", "step"), line("anything else is asked to the agent", "hint"));
        if (cmd === "whoami") print(line(shell.whoami, "step"));
        if (cmd === "projects") print(...shell.projects.map((p) => linkLine(`→ ${p.title}`, p.href)));
        if (cmd === "contact") print(linkLine(`→ ${shell.email}`, `mailto:${shell.email}`));
        return;
      }
      void play(simulate(q.replace(/"/g, "'")));
    });
  }
</script>

<style>
  .scene {
    --lid-open: 0.9s;
    position: relative;
    margin: 0;
    /* A long lens, like a product photo: the deck stays close to the screen's
       width instead of flaring out wide-angle. The padding reserves room for
       the folded deck and the caption below it. */
    perspective: 3200px;
    perspective-origin: 50% 20%;
    padding-bottom: 27%;
  }

  /* Soft contact shadow under the machine. */
  .scene::after {
    content: "";
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 6%;
    height: 12%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(var(--shadow) / 0.22), transparent);
    filter: blur(6px);
    z-index: -1;
  }

  /* A fixed, gentle three-quarter view, like a product shot. It holds still:
     no pointer tilt, no scroll tilt, so the screen is always easy to use. */
  .laptop {
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(10deg);
    /* In a preserve-3d stack this element's own (empty) plane sits in front
       of the tilted lid and would swallow clicks; only the lid takes input. */
    pointer-events: none;
  }

  .lid {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 16 / 10.4;
    padding: 2.4%;
    border-radius: 16px 16px 4px 4px;
    background: linear-gradient(160deg, #2a2c33, #16171b);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      0 1px 0 #0b0c0f;
    transform-origin: 50% 100%;
    transform: rotateX(4deg);
    pointer-events: auto;
    animation: lid-open var(--lid-open) var(--ease) 150ms both;
  }

  /* The deck, hinged at the lid's bottom edge and folded toward you: space
     black aluminium with speaker grilles, the keyboard, and the trackpad. */
  .base {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    aspect-ratio: 1.41;
    container-type: inline-size;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: auto 1fr;
    align-content: start;
    column-gap: 2.4cqi;
    row-gap: 3cqi;
    padding: 4.5cqi 0 3.5cqi;
    border-radius: 0 0 3.2cqi 3.2cqi;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.35), transparent 6%),
      linear-gradient(180deg, #3a3b3f, #2c2d31 60%, #26272a);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.05),
      inset 0 -2px 0 rgb(255 255 255 / 0.08);
    transform-origin: 50% 0;
    transform: rotateX(var(--deck, 70deg));
    pointer-events: auto;
  }

  /* Speaker grilles either side of the keyboard. */
  .grille {
    margin-block: 0.4cqi;
    background: radial-gradient(circle, #121214 0.22cqi, transparent 0.28cqi) 0 0 / 0.9cqi 0.9cqi;
    opacity: 0.9;
  }

  .base :global(.kb) {
    grid-column: 2;
  }

  .trackpad {
    grid-column: 1 / -1;
    justify-self: center;
    position: relative;
    width: 44cqi;
    height: 100%;
    max-height: 27cqi;
    border-radius: 1.6cqi;
    background: linear-gradient(180deg, #323337, #2b2c30);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.07),
      inset 0 1px 0 rgb(255 255 255 / 0.06);
    cursor: pointer;
    transition: transform 90ms var(--ease), box-shadow 160ms var(--ease);
  }

  .trackpad.down {
    transform: scale(0.985);
    box-shadow:
      inset 0 0 0 1px rgb(41 151 255 / 0.5),
      0 0 3cqi -1cqi rgb(41 151 255 / 0.5);
  }

  /* The camera housing in the top bezel. */
  .notch {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 50%;
    width: 13%;
    height: 3.6%;
    translate: -50% 0;
    border-radius: 0 0 10px 10px;
    background: #0b0c0f;
  }

  .notch::after {
    content: "";
    position: absolute;
    top: 30%;
    left: 50%;
    width: 7px;
    height: 7px;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #2a3550, #07080b 70%);
  }

  /* One calm motion on load: the display eases up into place and fades in. */
  @keyframes lid-open {
    from {
      opacity: 0;
      transform: rotateX(-22deg);
    }
  }

  .screen {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
    border-radius: 6px;
    background: #0e1016;
    color: #d6dae4;
    overflow: hidden;
    /* Sized from the lid, not the window, so the screen reads the same at any page width. */
    font: 500 clamp(10px, 1.75cqi, 12.5px) / 1.6 ui-monospace, "SF Mono", "Cascadia Code", Menlo, Consolas, monospace;
  }

  /* macOS window chrome: traffic lights, then the file tabs. */
  .chrome {
    display: flex;
    align-items: flex-end;
    gap: 0.9em;
    padding: 0.5em 0.6em 0 0.9em;
    background: #151821;
    border-bottom: 1px solid #23283a;
  }

  .lights {
    display: flex;
    gap: 0.5em;
    align-self: center;
    padding-bottom: 0.2em;
  }

  .lights i {
    width: 0.85em;
    height: 0.85em;
    border-radius: 50%;
    background: #ff5f57;
  }

  .lights i:nth-child(2) {
    background: #febc2e;
  }

  .lights i:nth-child(3) {
    background: #28c840;
  }

  .tabs {
    display: flex;
    gap: 2px;
  }

  [role="tab"] {
    padding: 0.35em 0.9em;
    border: 0;
    border-radius: 6px 6px 0 0;
    background: transparent;
    color: #8a93a8;
    font: inherit;
    cursor: pointer;
    min-height: 34px;
  }

  [role="tab"][aria-selected="true"] {
    background: #0e1016;
    color: #f1f3f8;
  }

  [role="tab"]:focus-visible {
    outline: 2px solid #7aa2ff;
    outline-offset: -2px;
  }

  .code {
    margin: 0;
    padding: 0.8em 1em;
    overflow: hidden;
    white-space: pre;
  }

  .code:focus-visible {
    outline: 2px solid #7aa2ff;
    outline-offset: -2px;
  }

  .ln {
    display: block;
  }

  /* Each line reveals left to right in character steps, after the lid opens. */
  @media (prefers-reduced-motion: no-preference) {
    .typing .ln {
      animation: type var(--t) steps(var(--n)) calc(var(--lid-open) + 200ms + var(--d)) both;
    }
    .typing.replay .ln {
      animation-delay: var(--d);
    }
  }

  @keyframes type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .code :global(.k) {
    color: #c792ea;
  }
  .code :global(.s) {
    color: #c3e88d;
  }
  .code :global(.c) {
    color: #6c7590;
    font-style: italic;
  }
  .code :global(.n) {
    color: #f78c6c;
  }
  .code :global(.f) {
    color: #82aaff;
  }

  .term {
    border-top: 1px solid #23283a;
    background: #0a0c11;
  }

  .term-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.3em 0.6em 0.3em 1em;
    color: #8a93a8;
  }

  .run {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 34px;
    padding: 0.25em 0.85em;
    border: 0;
    border-radius: 999px;
    background: #2f6bff;
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: transform 120ms var(--ease), background-color 120ms var(--ease);
  }

  @media (hover: hover) {
    .run:hover {
      background: #4a7dff;
    }
  }

  .run:active {
    transform: scale(0.96);
  }

  .run:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .run[aria-busy="true"] {
    background: #2a3550;
    cursor: progress;
  }

  .log {
    height: 6.6em;
    margin: 0;
    padding: 0 1em 0.2em;
    list-style: none;
    overflow-y: auto;
    scrollbar-width: none;
    white-space: pre;
  }

  .log :global(a) {
    color: #82aaff;
  }

  .ask {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.25em 1em 0.5em;
    color: #5ee08f;
  }

  .ask input {
    flex: 1;
    min-width: 0;
    min-height: 34px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #f1f3f8;
    font: inherit;
    caret-color: #5ee08f;
  }

  .ask input::placeholder {
    color: #59617a;
  }

  .ask input:focus-visible {
    outline: none;
  }

  .ask:focus-within {
    background: #11151f;
    box-shadow: inset 2px 0 0 #5ee08f;
  }

  @media (pointer: coarse) {
    /* Avoid iOS zooming into the page when the field gains focus. */
    .ask input {
      font-size: 16px;
    }
  }

  .log :global(.prompt) {
    color: #f1f3f8;
  }

  .log :global(.hint) {
    color: #6c7590;
  }

  .log :global(.step) {
    color: #9aa3b8;
    animation: line-in 180ms var(--ease) both;
  }

  .log :global(.result) {
    font-weight: 700;
    animation: pop 360ms cubic-bezier(0.2, 1.4, 0.4, 1) both;
  }

  .log :global(.result.answer) {
    color: #5ee08f;
  }

  .log :global(.result.person) {
    color: #ffc062;
  }

  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateX(-4px);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
  }

  figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    text-align: center;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  /*
    Phones: a miniature laptop shrinks the code to ~9px and the controls
    below Apple's 44pt touch minimum. Instead, the screen becomes a flat,
    full-width app window at a readable size, like an iOS app card. The 3D
    deck and keyboard are decoration, so they step aside.
  */
  @media (max-width: 640px) {
    .scene {
      perspective: none;
      padding-bottom: 0;
    }
    .scene::after,
    .notch,
    .base {
      display: none;
    }
    .laptop {
      transform: none;
    }
    .lid {
      aspect-ratio: auto;
      padding: 0;
      background: none;
      box-shadow: none;
      transform: none;
      animation: card-in 500ms var(--ease) both;
    }
    .screen {
      height: auto;
      /* Keep long code lines from widening the window past the card. */
      grid-template-columns: minmax(0, 1fr);
      border-radius: var(--radius-m);
      box-shadow:
        0 0 0 1px rgb(255 255 255 / 0.06),
        0 18px 40px -18px rgb(var(--shadow) / 0.5);
      font-size: 12px;
    }
    .chrome {
      padding-top: 0;
    }
    .tabs {
      overflow-x: auto;
      scrollbar-width: none;
    }
    [role="tab"],
    .run {
      min-height: 44px;
    }
    /* Long lines scroll inside the window, never the page. */
    .code {
      min-height: 15em;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    /* Long lines wrap instead of scrolling sideways on a narrow screen. */
    .log {
      height: 8em;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .ask input {
      min-height: 44px;
    }
    figcaption {
      position: static;
      margin-top: 0.9rem;
    }
    /* Lines type in once the card has landed, not after a lid that isn't there. */
    .scene {
      --lid-open: 0.4s;
    }
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lid,
    .log :global(.step),
    .log :global(.result) {
      animation: none;
    }
  }
</style>
